# Uygulama ortamı: development | staging | production
PAI_ENV=development

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
PAI_LOG_LEVEL=INFO

# Veri kök dizini (varsayılan: ./data)
PAI_DATA_DIR=./data

# Model eser dizini
PAI_MODEL_DIR=./models

# API
PAI_API_HOST=0.0.0.0
PAI_API_PORT=8000

# Anonimleştirme için gizli tuz (üretimde MUTLAKA değiştirin)
PAI_ANON_SALT=degistirin-bu-degeri-uretimde

# Veritabanı (boş bırakılırsa <PAI_DATA_DIR>/psikiyatri.db SQLite kullanılır)
# Üretim örneği: postgresql+psycopg://kullanici:parola@sunucu:5432/psikiyatri
# PAI_DATABASE_URL=

# JWT imzalama anahtarı (üretimde MUTLAKA değiştirin)
PAI_SECRET_KEY=degistirin-jwt-anahtarini-uretimde

# Oturum süresi (dakika)
PAI_ACCESS_TOKEN_EXPIRE_MINUTES=480

# İlk açılışta oluşturulan yönetici hesabı (kullanıcı tablosu boşsa)
PAI_ADMIN_USERNAME=admin
PAI_ADMIN_PASSWORD=degistir123
