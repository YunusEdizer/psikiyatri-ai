# docker/.env — üretim ayarları (bu dosyayı .env olarak KOPYALAYIP doldurun)
# Sırları üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Zorunlu: üretim kipi + sırlar ---------------------------------------
# Sistem, aşağıdaki sırlar varsayılan bırakılırsa üretimde BAŞLAMAYI REDDEDER.
PAI_ENV=production

# İlk yönetici hesabının parolası (kullanıcı adı: admin)
PAI_ADMIN_PASSWORD=BURAYA-GUCLU-PAROLA

# JWT imzalama anahtarı (uzun rastgele dize)
PAI_SECRET_KEY=BURAYA-RASTGELE-UZUN-ANAHTAR

# Takma-kimlik (pseudonym) HMAC tuzu — DEĞİŞİRSE eski takma-kimlikler eşleşmez;
# bir kez üretin, güvenle saklayın, bir daha değiştirmeyin.
PAI_ANON_SALT=BURAYA-RASTGELE-UZUN-TUZ

# --- Alan adı (Caddy otomatik HTTPS) --------------------------------------
DOMAIN=psikiyatri.siteniz.com

# --- İsteğe bağlı ----------------------------------------------------------
# Whisper modeli (varsayılan: small). Daha hızlı ama daha az doğru: base
# PAI_WHISPER_MODEL=small
# PostgreSQL kullanmak isterseniz (varsayılan: data/ altında SQLite):
# PAI_DATABASE_URL=postgresql+psycopg2://kullanici:parola@db:5432/psikiyatri
